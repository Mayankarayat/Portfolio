# Canonical origin used for metadata, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://portfolio-chi-vert-33.vercel.app

# EmailJS (public, browser-safe identifiers). Defaults in src/config/site.ts
# match the previously deployed configuration; override per environment here.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
